# Build context = repo root for apps/web/Dockerfile and pipeline/Dockerfile (T-013).
# Keep the context small and secret-free: deny by default, then allow what the images need.
**

# Workspace manifests
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!tsconfig.base.json

# Web app and the schema package it imports
!apps/web/
!packages/schema/
# Per-country "See listings" config the web build reads (scripts/listings.mjs)
!config/countries/

# Pipeline (needs packages/schema/schemas at runtime too). Tests and fixtures stay out of the
# jobs image (T-013 review): the image ships code, not sample data.
!pipeline/
pipeline/tests

# Published catalogue releases only (the web Dockerfile copies just the latest one)
!data/releases/
# The photo bundle is unpacked into data/releases/<n>/images/ by fetch-release.mjs; only those
# files go into the image (T-168), so the 29 MB tar stays out of the build context.
data/releases/*/images.tar

# Never send these, even inside allowed folders
**/node_modules
**/.next
**/.turbo
**/test-results
**/playwright-report
**/*.tsbuildinfo
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
